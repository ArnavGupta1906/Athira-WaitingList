# Google Apps Script Configuration
# Replace this with your actual Google Apps Script Web App URL
# The URL should end with /exec, not /library/...
# Example: https://script.google.com/macros/s/AKfycbzXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX/exec
REACT_APP_GOOGLE_APPS_SCRIPT_URL=your_google_apps_script_web_app_url_here

# Optional: Add other environment variables as needed
# REACT_APP_GOOGLE_SHEET_ID=your_google_sheet_id_here
